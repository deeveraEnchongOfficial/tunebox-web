// TuneBox Web — Prisma schema (MongoDB) with Better Auth models.
//
// Better Auth generates its own string IDs (nanoid-style), so its models
// (User, Session, Account, Verification) do NOT use @default(auto()) or
// @db.ObjectId — their id fields are plain Strings with no default.
//
// Our own models (Music, Favorite, Playlist, etc.) use MongoDB ObjectIDs
// via @default(auto()) @db.ObjectId. Foreign keys that reference
// Better Auth's User.id are plain Strings (no @db.ObjectId).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
// Better Auth — user, session, account, verification
// (IDs are generated by Better Auth, not by MongoDB)
// ───────────────────────────────────────────────────────────

model User {
  id            String   @id @map("_id")
  email         String   @unique
  name          String
  image         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  music       Music[]
  favorites   Favorite[]
  playlists   Playlist[]
  downloads   Download[]
  syncRecords SyncRecord[]
}

model Session {
  id        String   @id @map("_id")
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                     String    @id @map("_id")
  userId                 String
  accountId              String
  providerId             String
  accessToken            String?
  refreshToken           String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  idToken                String?
  password               String?
  issuer                 String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ───────────────────────────────────────────────────────────
// Music library (our own models — use MongoDB ObjectIDs)
// ───────────────────────────────────────────────────────────

model Music {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  sourceType      SourceType
  sourceId        String
  sourceUrl       String
  title           String
  artist          String?
  channelName     String?
  thumbnailUrl    String?
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites     Favorite[]
  playlistItems PlaylistItem[]
  downloads     Download[]

  @@unique([userId, sourceType, sourceId])
  @@index([userId, createdAt])
}

model Favorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  musicId   String   @db.ObjectId
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  music Music @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@unique([userId, musicId])
  @@index([userId])
}

model Playlist {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  name        String
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId])
}

model PlaylistItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  playlistId String   @db.ObjectId
  musicId    String   @db.ObjectId
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  music    Music    @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@unique([playlistId, musicId])
  @@index([playlistId, position])
}

// ───────────────────────────────────────────────────────────
// Audio downloads — MP3 files stored on Google Drive
// (storageKey = Drive file ID)
// ───────────────────────────────────────────────────────────

model Download {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  musicId         String         @db.ObjectId
  sourceUrl       String
  storageKey      String?
  fileSize        Int?
  durationSeconds Int?
  mimeType        String?
  checksum        String?
  status          DownloadStatus
  error           String?
  startedAt       DateTime?
  createdAt       DateTime       @default(now())
  completedAt     DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  music Music @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ───────────────────────────────────────────────────────────
// Offline-first sync
// ───────────────────────────────────────────────────────────

model SyncRecord {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String
  entityType String
  entityId   String
  operation  String
  version    Int
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// ───────────────────────────────────────────────────────────
// Enums
// ───────────────────────────────────────────────────────────

enum SourceType {
  YOUTUBE
  AUTHORIZED_AUDIO
}

enum DownloadStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  DELETED
}

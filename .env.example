# ───────────────────────────────────────────────────────────
# TuneBox Web (Next.js backend) — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ───────────────────────────────────────────────────────────

# Database (MongoDB Atlas)
DATABASE_URL="mongodb+srv://USER:PASS@cluster0.vtnfb.mongodb.net/tunebox?retryWrites=true&w=majority"

# Auth
AUTH_SECRET="replace-with-a-long-random-string"

# S3-compatible object storage (authorized downloadable audio / assets)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="tunebox-downloads"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_PUBLIC_BASE_URL="http://localhost:9000"

# YouTube Data API (metadata only — NOT for audio extraction)
YOUTUBE_API_KEY=""

# Google Drive (central account — run `pnpm drive:auth` to get the refresh token)
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
# Optional — folder ID to reuse; auto-creates "TuneBox" folder if unset
GOOGLE_DRIVE_FOLDER_ID=""
# Optional — temp dir for downloads (defaults to os.tmpdir())
DOWNLOAD_TMP_DIR=""
# Optional — base64-encoded cookies.txt to bypass YouTube bot-checks on datacenter IPs
YOUTUBE_COOKIES=""

# Redis (optional, for caching / rate limiting)
REDIS_URL=""

# App
NODE_ENV="development"
PORT=3000
